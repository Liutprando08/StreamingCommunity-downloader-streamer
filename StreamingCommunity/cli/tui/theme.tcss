/*
 * OSTE TUI theme.
 *
 * Colours live here as CSS variables so screens stay free of magic hex
 * values. Loaded by OsteApp via ``CSS_PATH``.
 *
 * The app runs on Textual's built-in "catppuccin-mocha" theme; the values
 * below are the matching Catppuccin Mocha tokens so custom panels, borders
 * and accents stay coherent with the widgets driven by the theme.
 */

$oste-bg: #181825; /* mantle    */
$oste-panel: #313244; /* surface0 */
$oste-border: #585b70; /* surface2 */
$oste-accent: #cba6f7; /* mauve     */
$oste-text: #cdd6f4; /* text     */
$oste-muted: #7f849c; /* overlay1 */

Screen {
    background: $oste-bg;
}

/* ── Home ────────────────────────────────────────────────────────────── */
HomeScreen .home-root {
    width: 1fr;
    height: 1fr;
    border: solid $oste-border;
    layout: horizontal;
    content-align: center middle;
}

HomeScreen #sidebar {
    width: 34;
    height: 100%;
    border-right: solid $oste-border;
    background: $oste-panel;
}

HomeScreen #sidebar OptionList {
    height: 1fr;
    border: none;
    background: transparent;
}

HomeScreen #main-content {
    width: 1fr;
    height: 100%;
    layout: vertical;
}

HomeScreen #home-top {
    height: auto;
    padding: 1 2 0 2;
}

HomeScreen #home-title-view {
    width: 1fr;
    height: auto;
    content-align: center top;
}

HomeScreen #home-search-bar {
    height: auto;
}

HomeScreen #home-search-bar Input {
    width: 1fr;
    margin-right: 1;
}

HomeScreen #sector-tabs {
    /* Tabs must keep its intrinsic height (2); `auto` makes it expand to
       fill #home-top, which would leave no room for the results table.
       The top margin keeps the labels clear of the search input's tall
       border (its half-block characters can bleed into the row below). */
    height: 2;
    margin-top: 1;
}

HomeScreen #home-status-bar {
    height: 1;
    padding: 0 2;
}

HomeScreen #home-loader {
    width: 4;
    height: 1;
    display: none;
    margin-right: 1;
}

HomeScreen #home-status {
    width: 1fr;
    height: 1;
}

HomeScreen #home-results-box {
    height: 1fr;
    /* Never collapse to nothing: on short terminals the banner + controls
       used to consume the whole screen and hide the results entirely. */
    min-height: 5;
    border: round $oste-accent;
    padding: 0 1;
    margin: 0 2;
    /* Hidden until the first search so the empty table doesn't greet you. */
    display: none;
}

HomeScreen #home-results-box DataTable {
    height: 1fr;
}

/* ── Settings ────────────────────────────────────────────────────────── */
SettingsScreen .settings-root {
    height: 1fr;
    padding: 1 2;
}

SettingsScreen #settings-tabs {
    /* Keep the intrinsic height (see the home tabs): `auto` would expand. */
    height: 2;
}

SettingsScreen #settings-body {
    height: 1fr;
    margin-top: 1;
}

SettingsScreen .settings-box {
    width: 1fr;
    height: 1fr;
    border: round $oste-accent;
    padding: 0 1;
    margin-right: 1;
}

SettingsScreen #settings-tree {
    height: 1fr;
    background: transparent;
}

SettingsScreen #settings-editor {
    width: 46;
    height: 1fr;
}

SettingsScreen #settings-path {
    height: auto;
    margin-bottom: 1;
}

SettingsScreen #settings-value {
    width: 1fr;
}

SettingsScreen #settings-switch {
    margin: 1 0;
}

SettingsScreen #settings-editor-actions {
    height: auto;
    margin-top: 1;
}

SettingsScreen #settings-hint {
    height: auto;
    margin-top: 1;
    color: $oste-muted;
}

SettingsScreen #settings-actions {
    height: auto;
    margin-top: 1;
}

SettingsScreen #settings-actions Button {
    margin-right: 1;
}

SettingsScreen #settings-status {
    height: auto;
    margin-top: 1;
}

/* ── Shared flow screens (search / detail / seasons / episodes / …) ──── */
.flow-root {
    height: 1fr;
    padding: 1 2;
}

.flow-root #table-box {
    height: 1fr;
    border: round $oste-accent;
    padding: 1;
}

.flow-root #table-box DataTable {
    height: 1fr;
}

/* Consistent table headers across search / seasons / episodes / music. */
DataTable > .datatable--header {
    background: $oste-panel;
    color: $oste-accent;
    text-style: bold;
}

DataTable > .datatable--header-cursor {
    background: $oste-border;
    color: $oste-text;
}

.flow-root #queue-log {
    height: 6;
    border: round $primary;
    margin-top: 1;
}

.flow-root Horizontal {
    height: auto;
    margin: 1 0;
}

.flow-root Horizontal Input {
    width: 1fr;
    margin-right: 1;
}

.flow-root Horizontal Button {
    margin-left: 1;
}

.flow-root #music-mode {
    width: 1fr;
    margin-bottom: 1;
}

.flow-root #music-query {
    margin-bottom: 1;
}

/* ── Search (query bar + results / preview split) ────────────────────── */
.flow-root #search-title {
    height: auto;
    margin-bottom: 1;
}

.flow-root #search-status {
    height: auto;
}

.flow-root #search-split {
    height: 1fr;
    margin: 1 0 0 0;
}

.flow-root #search-split #table-box {
    width: 2fr;
}

.flow-root #preview-container {
    width: 1fr;
    height: 1fr;
    border: round $oste-border;
    background: $oste-panel;
    padding: 0 1;
    margin-left: 1;
}

.flow-root #preview-box {
    height: 1fr;
    padding: 1;
    overflow-y: auto;
}

.flow-root #search-preview {
    height: auto;
}

.flow-root #preview-actions {
    height: auto;
    margin: 0 0 1 0;
}

/* ── Detail (title metadata + actions split) ─────────────────────────── */
.flow-root #detail-heading {
    height: auto;
    margin-bottom: 1;
}

.flow-root #detail-split {
    height: 1fr;
    margin: 1 0 0 0;
}

.flow-root #info-box {
    width: 2fr;
    height: 1fr;
    border: round $oste-accent;
    padding: 1 2;
    overflow-y: auto;
}

.flow-root #entry-title {
    height: auto;
    text-style: bold;
}

.flow-root #entry-badges {
    height: auto;
    margin-bottom: 1;
}

.flow-root #entry-desc {
    height: auto;
    margin: 1 0;
}

.flow-root #entry-details {
    height: auto;
}

.flow-root #actions-box {
    width: 1fr;
    height: 1fr;
    border: round $oste-border;
    background: $oste-panel;
    padding: 1;
    margin-left: 1;
}

.flow-root #actions-title {
    height: auto;
    margin-bottom: 1;
}

.flow-root #actions-box Button {
    width: 100%;
    margin: 0 0 1 0;
}

.flow-root #dub-row {
    height: auto;
    align: center middle;
    padding: 0 0 1 0;
}

.flow-root #dub-label {
    margin-right: 1;
}

.flow-root #audio-title {
    height: auto;
    margin-bottom: 1;
}

.flow-root #audio-status {
    height: auto;
}

.flow-root #audio-actions {
    height: auto;
    margin: 1 0 0 0;
}

/* ── Selection screens (seasons / episodes split) ────────────────────── */
.flow-root .select-split {
    height: 1fr;
    margin: 1 0 0 0;
}

.flow-root .select-split #table-box {
    width: 2fr;
}

.flow-root .select-card {
    width: 1fr;
    height: 1fr;
    border: round $oste-border;
    background: $oste-panel;
    padding: 0 1;
    margin-left: 1;
}

.flow-root .select-card .select-card-box {
    height: 1fr;
    padding: 1;
    overflow-y: auto;
}

.flow-root .select-card .select-preview {
    height: auto;
}

.flow-root .select-card .select-actions {
    height: auto;
    margin: 0 0 1 0;
}

/* ── Queue (download/stream progress) ─────────────────────────────────── */
.flow-root #queue-summary {
    height: auto;
    margin: 1 0 0 0;
}

/* ── Activity (live downloads + history) ─────────────────────────────── */
.flow-root .activity-heading {
    text-style: bold;
    margin-top: 1;
}

.flow-root .activity-box {
    height: 1fr;
    min-height: 4;
    border: round $oste-accent;
    padding: 0 1;
}

.flow-root .activity-box DataTable {
    height: 1fr;
}

.flow-root #activity-status {
    height: auto;
    margin-top: 1;
}
